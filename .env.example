# The app connects as somiti_app: not the table owner, no BYPASSRLS.
DATABASE_URL=postgres://somiti_app:somiti_app_dev@localhost:5432/somiti
# Migrations run as somiti_owner, which owns the tables.
DATABASE_OWNER_URL=postgres://somiti_owner:somiti_owner_dev@localhost:5432/somiti
# Signs sign-in codes. Optional in development; required in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Encrypts members' NID numbers. Optional in development; required in production.
# 32 random bytes, base64url: same command as AUTH_SECRET. Keep a backup: without it NIDs can't be read.
MEMBER_DATA_KEY=
# Production only: 1 prints sign-in codes to the server log instead of texting them.
SMS_CONSOLE=
